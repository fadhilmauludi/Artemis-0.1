# ---- Server-side secrets (used only by the /api functions; never exposed to the browser) ----
# On Vercel: Project Settings -> Environment Variables.  Locally: copy this file to .env
FIRMS_API_KEY=
OPENWEATHER_API_KEY=
NEWSDATA_API_KEY=
EVERY_ORG_API_KEY=

# ---- Public client values (VITE_* are bundled into the site and visible to everyone) ----
VITE_CARTO_API_KEY=
# Configure verified, direct campaign URLs. Do not use a homepage.
VITE_KITABISA_RIAU_URL=
VITE_KITABISA_CENTRAL_KALIMANTAN_URL=
VITE_KITABISA_INDONESIA_URL=
# Optional Python discovery service, must be public HTTPS in production
VITE_DONATION_DISCOVERY_URL=
